# Copie para .env e ajuste (mínimo: JWT_SECRET).
# Lido pelo backend/app/config.py (pydantic-settings) e pelo docker compose.

DATABASE_URL=postgresql+psycopg2://structai:structai@db:5432/structai
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=structai
MINIO_SECRET_KEY=structai123
MINIO_BUCKET=structai
MINIO_SECURE=false

NODEODM_HOST=nodeodm
NODEODM_PORT=3000

# TROQUE em qualquer ambiente que não seja dev local
JWT_SECRET=dev-secret
JWT_EXPIRE_MINUTES=1440

# high | medium (medium = mais rápido, para smoke tests)
ODM_QUALITY=high
